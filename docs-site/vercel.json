{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    }
  ]
}
